{
  "name": "kb-labs-web",
  "description": "KB Labs web monorepo: corporate site, docs, and SaaS shell.",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:all": "pnpm --filter @kb-labs/web-site build && pnpm --filter @kb-labs/docs-site build",
    "clean": "rimraf node_modules apps/*/node_modules apps/*/.next",
    "dev:all": "pnpm --filter @kb-labs/web-site dev & pnpm --filter @kb-labs/docs-site dev",
    "lint:all": "pnpm --filter @kb-labs/web-site lint && pnpm --filter @kb-labs/docs-site lint",
    "typecheck:all": "pnpm --filter @kb-labs/web-site typecheck && pnpm --filter @kb-labs/docs-site typecheck"
  },
  "devDependencies": {
    "@kb-labs/sdk": "workspace:*",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": "24.x",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.4.0"
}
