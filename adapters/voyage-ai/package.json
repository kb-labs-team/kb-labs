{
  "name": "@kb-labs/adapters-voyage-ai",
  "description": "Voyage AI adapter implementing IEmbeddings interface",
  "version": "2.120.1",
  "type": "module",
  "main": "./dist/embeddings.js",
  "types": "./dist/embeddings.d.ts",
  "exports": {
    ".": {
      "types": "./dist/embeddings.d.ts",
      "import": "./dist/embeddings.js"
    },
    "./embeddings": {
      "types": "./dist/embeddings.d.ts",
      "import": "./dist/embeddings.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@kb-labs/devkit": "workspace:*",
    "@kb-labs/sdk": "workspace:*",
    "@types/node": "^24.3.3",
    "eslint": "^9",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "kb": {
    "manifest": "./dist/embeddings-manifest.js"
  },
  "peerDependencies": {
    "@kb-labs/sdk": "workspace:^"
  },
  "sideEffects": false
}
