// Gateway HTTP pressure-control overlay (ADR-0056 + core-config ADR-0001).
//
// The installed Gateway fixture applies these values using kb config set,
// restarts the platform, and restores the original configuration on reset.
{
  "gateway": {
    "pressure": {
      "enabled": true,
      "perService": {
        "marketplace": { "requestsPerSecond": 5, "safetyMargin": 1 }
      },
      "perRoute": [
        {
          "resource": "gateway:route:health",
          "pathPrefix": "/health",
          "limits": { "requestsPerSecond": 3, "safetyMargin": 1 }
        }
      ],
      "perTenant": {
        "enabled": true,
        "limits": { "requestsPerMinute": 30, "safetyMargin": 1 }
      }
    }
  }
}
