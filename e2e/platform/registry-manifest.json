    {
      "id": "@kb-labs/review",
      "pkg": "@kb-labs/review",
      "description": "AI code review",
      "default": false
    },
    {
      "id": "@kb-labs/commit",
      "pkg": "@kb-labs/commit",
      "description": "AI commit generation",
      "default": false
    },
    {
      "id": "@kb-labs/release",
      "pkg": "@kb-labs/release",
      "description": "Release manager \u2014 plan, publish, workflow templates",
      "default": false
    },
    {
      "id": "@kb-labs/quality",
      "pkg": "@kb-labs/quality",
      "description": "Code quality, architecture analysis",
      "default": false
