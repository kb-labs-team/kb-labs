    },
    {
      "pkg": "fixture-compat",
      "description": "Journey fixture for installed plugin update compatibility",
      "default": false
    },
    {
      "id": "@kb-labs/e2e-plugin-error",
      "pkg": "@kb-labs/e2e-plugin-error",
      "description": "Journey fixture for correlated plugin handler failure diagnostics",
      "default": false
    }
