{
  "version": "3.0.0",
  "registryUrl": "http://verdaccio:4873",
  "core": [
    { "name": "@kb-labs/cli-bin" },
    { "name": "@kb-labs/devkit" },
    { "name": "@kb-labs/sdk" },
    { "name": "@kb-labs/core-runtime" },
    { "name": "@kb-labs/core-contracts" },
    { "name": "@kb-labs/shared-cli-ui" },
    { "name": "@kb-labs/core-state-daemon" },
    { "name": "@kb-labs/adapters-kblabs-gateway" }
  ],
  "services": [
    {
      "id": "rest",
      "pkg": "@kb-labs/rest-api-app",
      "description": "REST API (port 5050)",
      "default": true,
      "port": 5050,
      "gatewayPrefix": "/api/v1",
      "gatewayWebSocket": true
    },
    {
      "id": "workflow",
      "pkg": "@kb-labs/workflow-daemon",
      "description": "Workflow engine (port 7778)",
      "default": true,
      "port": 7778,
      "gatewayPrefix": "/api/exec",
      "gatewayRewrite": "",
      "plugin": "@kb-labs/workflow-entry"
    },
    {
      "id": "gateway",
      "pkg": "@kb-labs/gateway-app",
      "description": "Central router (port 4000)",
      "default": true,
      "port": 4000
    },
    {
      "id": "marketplace",
      "pkg": "@kb-labs/marketplace-app",
      "description": "Marketplace (port 5070)",
      "default": true,
      "port": 5070,
      "gatewayPrefix": "/api/v1/marketplace"
    },
    {
      "id": "marketplace-registry",
      "pkg": "@kb-labs/marketplace-registry-app",
      "description": "Marketplace registry (port 5071)",
      "default": true,
      "port": 5071
    },
    {
      "id": "studio",
      "pkg": "@kb-labs/studio-app",
      "description": "Web UI (port 3000)",
      "default": true,
      "port": 3000
    },
    {
      "id": "mcp-daemon",
      "pkg": "@kb-labs/mcp-app",
      "description": "MCP Daemon (port 7779)",
      "default": true,
      "port": 7779
    }
  ],
  "adapters": [
    { "name": "@kb-labs/data-store" },
    { "name": "@kb-labs/adapters-pino" },
    { "name": "@kb-labs/adapters-log-ringbuffer" },
    { "name": "@kb-labs/adapters-analytics-file" },
    { "name": "@kb-labs/adapters-sqlite" },
    { "name": "@kb-labs/adapters-service-transport-http" },
    { "name": "@kb-labs/adapters-state-broker" }
  ],
  "adapterConfig": {
    "documentDatabase": "@kb-labs/adapters-sqlite",
    "kvStore": "@kb-labs/adapters-sqlite/kv",
    "adapters": {
      "serviceTransport": "@kb-labs/adapters-service-transport-http"
    }
  },
  "plugins": [
    {
      "id": "workflow",
      "pkg": "@kb-labs/workflow-entry",
      "description": "Workflow engine plugin — CLI, REST routes and WS channels for the workflow daemon",
      "default": true
    },
    {
      "id": "marketplace",
      "pkg": "@kb-labs/marketplace-entry",
      "description": "Install, list, enable plugins",
      "default": true
    },
    {
      "id": "mind",
      "pkg": "@kb-labs/mind-entry",
      "description": "AI code search (RAG)",
      "default": false
    },
    {
      "id": "agents",
      "pkg": "@kb-labs/agent-entry",
      "description": "Autonomous agents",
      "default": false
    },
    {
      "id": "review",
      "pkg": "@kb-labs/review-entry",
      "description": "AI code review",
      "default": true
    },
    {
      "id": "commit",
      "pkg": "@kb-labs/commit-entry",
      "description": "AI commit generation",
      "default": true
    },
    {
      "id": "scaffold",
      "pkg": "@kb-labs/scaffold",
      "description": "Scaffold plugins and adapters",
      "default": true
    },
    {
      "id": "release",
      "pkg": "@kb-labs/release-manager-cli",
      "description": "Release manager — plan, publish, workflow templates",
      "default": true
    },
    {
      "id": "quality",
      "pkg": "@kb-labs/quality-entry",
      "description": "Code quality, architecture analysis",
      "default": true
    }
  ],
  "binaries": [
    {
      "id": "kb-dev",
      "repo": "kb-labs-team/kb-labs",
      "name": "kb-dev",
      "description": "Service manager",
      "default": true,
      "localPath": "/usr/local/bin/kb-dev"
    },
    {
      "id": "kb-devkit",
      "repo": "kb-labs-team/kb-labs",
      "name": "kb-devkit",
      "description": "Workspace orchestrator",
      "default": false,
      "localPath": "/usr/local/bin/kb-devkit"
    },
    {
      "id": "kb-deploy",
      "repo": "kb-labs-team/kb-labs",
      "name": "kb-deploy",
      "description": "Deployment manager",
      "default": false
    },
    {
      "id": "kb-monitor",
      "repo": "kb-labs-team/kb-labs",
      "name": "kb-monitor",
      "description": "Runtime monitor",
      "default": false
    }
  ]
}
