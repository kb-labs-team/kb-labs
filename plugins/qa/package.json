{
  "name": "@kb-labs/qa",
  "description": "CLI commands for KB Labs QA Plugin \u2014 qa:run, qa:save, qa:history, qa:trends, qa:regressions, baseline:update, baseline:status.",
  "version": "2.120.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin-manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./core/report": {
      "types": "./dist/core/report/index.d.ts",
      "import": "./dist/core/report/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && pnpm run build:studio",
    "build:studio": "rspack build --config rspack.studio.config.mjs",
    "clean": "rimraf dist",
    "dev": "tsup --config tsup.config.ts --watch",
    "dev:studio": "rspack build --config rspack.studio.config.mjs --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --passWithNoTests",
    "test:cli": "vitest run --config vitest.cli.config.ts",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "build:cli": "tsup --config tsup.config.ts"
  },
  "dependencies": {
    "@kb-labs/sdk": "workspace:*",
    "js-yaml": "^4.3.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@kb-labs/devkit": "workspace:*",
    "@types/node": "^24.3.3",
    "eslint": "^9",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11",
    "@kb-labs/studio-plugin-tools": "workspace:*",
    "@rspack/cli": "^2.2.8",
    "@rspack/core": "^2.2.8",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": "24.x",
    "pnpm": ">=9.0.0"
  },
  "kb": {
    "manifest": "./dist/manifest.js"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "@kb-labs/sdk": "workspace:*"
  },
  "sideEffects": false
}
