{
  "name": "@kb-labs/steward-core",
  "version": "2.120.1",
  "type": "module",
  "description": "Business logic for steward (pure, testable in isolation).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@kb-labs/steward-contracts": "workspace:*",
    "@kb-labs/sdk": "workspace:*"
  },
  "devDependencies": {
    "@kb-labs/core-runtime": "workspace:*",
    "@kb-labs/devkit": "workspace:*",
    "@types/node": "^24.0.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  }
}
