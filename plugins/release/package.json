{
  "name": "@kb-labs/release",
  "description": "KB Labs Release Manager - CLI commands for release management",
  "version": "2.120.1",
  "type": "module",
  "author": {
    "name": "Kirill Baranov",
    "url": "https://github.com/kirill-baranov"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./changelog": {
      "types": "./dist/changelog/index.d.ts",
      "import": "./dist/changelog/index.js"
    },
    "./checks": {
      "types": "./dist/checks/index.d.ts",
      "import": "./dist/checks/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && pnpm run build:studio",
    "build:templates": "cp -r src/workflows dist/",
    "build:studio": "rspack build --config rspack.studio.config.mjs",
    "clean": "rimraf dist",
    "dev": "tsup --watch",
    "dev:studio": "rspack build --config rspack.studio.config.mjs --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --passWithNoTests -c ../vitest.config.ts",
    "test:cli": "vitest run -c ../vitest.config.ts tests/__tests__/cli",
    "test:watch": "vitest -c ../vitest.config.ts",
    "type-check": "tsc --noEmit",
    "build:cli": "tsup --config tsup.config.ts"
  },
  "dependencies": {
    "@kb-labs/sdk": "workspace:*",
    "conventional-commits-parser": "^4.0.0",
    "semver": "^7.6.3",
    "simple-git": "^3.36.0",
    "glob": "^11.0.0",
    "globby": "^11.0.0",
    "npm-packlist": "^10.0.3",
    "zod": "^3.25.76",
    "@npmcli/arborist": "^10.0.2",
    "execa": "^9.5.3"
  },
  "devDependencies": {
    "@kb-labs/devkit": "workspace:*",
    "@types/node": "^24.3.3",
    "@types/semver": "^7.5.8",
    "eslint": "^9",
    "globby": "^11.0.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11",
    "@types/fs-extra": "^11.0.0",
    "@rspack/cli": "^2.2.8",
    "@rspack/core": "^2.2.8",
    "@types/npm-packlist": "^7.0.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/npmcli__arborist": "^6.3.3",
    "@kb-labs/studio-plugin-tools": "workspace:*"
  },
  "engines": {
    "node": "24.x",
    "pnpm": ">=9.0.0"
  },
  "kb": {
    "manifest": "./dist/manifest.js"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-router-dom": ">=6.0.0",
    "@kb-labs/sdk": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kirill-baranov/kb-labs-release-manager.git",
    "directory": "packages/release-cli"
  },
  "sideEffects": false
}
