{
  "name": "@kb-labs/review",
  "version": "2.120.1",
  "description": "CLI commands and manifest for the AI code review plugin",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin-manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./heuristic": {
      "types": "./dist/heuristic/index.d.ts",
      "import": "./dist/heuristic/index.js"
    },
    "./llm": {
      "types": "./dist/llm/index.d.ts",
      "import": "./dist/llm/index.js"
    },
    "./llm/architecture": {
      "types": "./dist/llm/analyzers/architecture-analyzer.d.ts",
      "import": "./dist/llm/analyzers/architecture-analyzer.js"
    },
    "./llm/security": {
      "types": "./dist/llm/analyzers/security-analyzer.d.ts",
      "import": "./dist/llm/analyzers/security-analyzer.js"
    },
    "./llm/naming": {
      "types": "./dist/llm/analyzers/naming-analyzer.d.ts",
      "import": "./dist/llm/analyzers/naming-analyzer.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "clean": "rimraf dist",
    "dev": "tsup --config tsup.config.ts --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --passWithNoTests",
    "test:cli": "vitest run --config vitest.cli.config.ts",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "build:cli": "tsup --config tsup.config.ts"
  },
  "dependencies": {
    "@kb-labs/sdk": "workspace:*",
    "simple-git": "^3.36.0",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@kb-labs/devkit": "workspace:*",
    "@types/node": "^24.3.3",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "24.x",
    "pnpm": ">=9.0.0"
  },
  "kb": {
    "manifest": "./dist/manifest.js"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "@kb-labs/sdk": "workspace:*"
  }
}
