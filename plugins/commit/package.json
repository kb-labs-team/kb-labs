{
  "name": "@kb-labs/commit",
  "description": "CLI commands and manifest for KB Labs Commit plugin - AI-powered commit generation.",
  "version": "2.120.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin-manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./cli": "./dist/cli/index.js",
    "./lifecycle": "./dist/lifecycle/index.js",
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./core/analyzer": {
      "types": "./dist/core/analyzer/index.d.ts",
      "import": "./dist/core/analyzer/index.js"
    },
    "./core/generator": {
      "types": "./dist/core/generator/index.d.ts",
      "import": "./dist/core/generator/index.js"
    },
    "./core/applier": {
      "types": "./dist/core/applier/index.d.ts",
      "import": "./dist/core/applier/index.js"
    },
    "./core/storage": {
      "types": "./dist/core/storage/index.d.ts",
      "import": "./dist/core/storage/index.js"
    },
    "./core/validator": {
      "types": "./dist/core/validator/index.d.ts",
      "import": "./dist/core/validator/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./contracts/contract": {
      "types": "./dist/contracts/contract.d.ts",
      "import": "./dist/contracts/contract.js"
    },
    "./contracts/schema": {
      "types": "./dist/contracts/schema.d.ts",
      "import": "./dist/contracts/schema.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && pnpm run build:studio",
    "build:cli": "tsup --config tsup.config.ts",
    "build:studio": "rspack build --config rspack.studio.config.mjs",
    "clean": "rimraf dist",
    "dev": "tsup --config tsup.config.ts --watch",
    "dev:studio": "rspack serve --config rspack.studio.config.mjs",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --passWithNoTests",
    "test:cli": "vitest run tests/cli",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@kb-labs/sdk": "workspace:*",
    "globby": "^11.0.0",
    "minimatch": "^10.0.1",
    "simple-git": "^3.36.0",
    "glob": "^11.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@kb-labs/devkit": "workspace:*",
    "@types/node": "^24.3.3",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11",
    "@kb-labs/studio-plugin-tools": "workspace:*",
    "@rspack/cli": "^2.1.2",
    "@rspack/core": "^2.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9"
  },
  "engines": {
    "node": "24.x",
    "pnpm": ">=9.0.0"
  },
  "kb": {
    "manifest": "./dist/manifest.js"
  },
  "peerDependencies": {
    "@ant-design/icons": "^5.4.0",
    "@tanstack/react-query": "^5.0.0",
    "antd": "^5.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "@kb-labs/sdk": "workspace:*"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "antd": {
      "optional": true
    },
    "@ant-design/icons": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  },
  "sideEffects": false
}
