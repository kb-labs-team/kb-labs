{
  "name": "@kb-labs/core-platform",
  "description": "Pure abstractions for KB Labs platform with minimal dependencies.",
  "version": "2.120.0",
  "type": "module",
  "author": "KB Labs",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js",
      "require": "./dist/adapters/index.cjs"
    },
    "./adapters/contract": {
      "types": "./dist/adapters/contract/index.d.ts",
      "import": "./dist/adapters/contract/index.js",
      "require": "./dist/adapters/contract/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./serializable": {
      "types": "./dist/serializable/index.d.ts",
      "import": "./dist/serializable/index.js",
      "require": "./dist/serializable/index.cjs"
    },
    "./noop": {
      "types": "./dist/noop/index.d.ts",
      "import": "./dist/noop/index.js",
      "require": "./dist/noop/index.cjs"
    },
    "./noop/adapters": {
      "types": "./dist/noop/adapters/index.d.ts",
      "import": "./dist/noop/adapters/index.js",
      "require": "./dist/noop/adapters/index.cjs"
    },
    "./noop/core": {
      "types": "./dist/noop/core/index.d.ts",
      "import": "./dist/noop/core/index.js",
      "require": "./dist/noop/core/index.cjs"
    },
    "./inmemory": {
      "types": "./dist/inmemory/index.d.ts",
      "import": "./dist/inmemory/index.js",
      "require": "./dist/inmemory/index.cjs"
    },
    "./inmemory/adapters": {
      "types": "./dist/inmemory/adapters/index.d.ts",
      "import": "./dist/inmemory/adapters/index.js",
      "require": "./dist/inmemory/adapters/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "dev": "tsup --config tsup.config.ts --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@kb-labs/devkit": "workspace:*",
    "@types/node": "^24.3.3",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "peerDependencies": {
    "vitest": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "keywords": [
    "abstractions",
    "hexagonal-architecture",
    "interfaces",
    "kb-labs",
    "platform"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kb-labs/kb-labs-core.git",
    "directory": "packages/core-platform"
  }
}
