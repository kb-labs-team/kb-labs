{
  "name": "@kb-labs/plugin-contracts",
  "description": "Plugin System Contracts - Pure types with 0 runtime dependencies",
  "version": "2.120.1",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./project-service-path": {
      "types": "./dist/project-service-path.d.ts",
      "import": "./dist/project-service-path.js",
      "require": "./dist/project-service-path.cjs"
    },
    "./node-engine-policy": {
      "types": "./src/node-engine-policy.d.mts",
      "import": "./src/node-engine-policy.mjs",
      "require": "./src/node-engine-policy.mjs"
    },
    "./color-policy": {
      "types": "./src/color-policy.d.mts",
      "import": "./src/color-policy.mjs",
      "require": "./src/color-policy.mjs"
    }
  },
  "files": [
    "dist",
    "src/node-engine-policy.mjs",
    "src/node-engine-policy.d.mts",
    "src/color-policy.mjs",
    "src/color-policy.d.mts"
  ],
  "scripts": {
    "build": "pnpm clean && tsup --config tsup.config.ts",
    "clean": "rimraf dist",
    "dev": "tsup --config tsup.config.ts --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && node ../../scripts/checks/typecheck-authored-esm.mjs"
  },
  "dependencies": {
    "@kb-labs/core-contracts": "workspace:*",
    "@kb-labs/core-platform": "workspace:*"
  },
  "devDependencies": {
    "@kb-labs/devkit": "workspace:*",
    "@types/node": "^24.3.3",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "24.x",
    "pnpm": ">=9.0.0"
  },
  "keywords": [
    "contracts",
    "kb-labs",
    "plugin",
    "v3"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
