{
  "name": "@kb-labs/plugin-template",
  "description": "Reference plugin template for the KB Labs ecosystem with devkit-powered tooling.",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "author": {
    "name": "Kirill Baranov",
    "url": "https://github.com/kirill-baranov"
  },
  "license": "MIT",
  "scripts": {
    "// \u2014\u2014\u2014 ci/qa": "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500",
    "// \u2014\u2014\u2014 cleanup": "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500",
    "// \u2014\u2014\u2014 core": "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500",
    "// \u2014\u2014\u2014 quality": "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500",
    "build": "tsup --config tsup.config.ts",
    "build:clean": "pnpm -r --filter ./packages/... run clean && pnpm run build",
    "check": "pnpm lint && pnpm type-check && pnpm test",
    "ci": "pnpm clean && pnpm build && pnpm check",
    "clean": "rimraf dist",
    "dev": "tsup --config tsup.config.ts --watch",
    "devkit:check": "node scripts/devkit-sync.mjs --check",
    "devkit:force": "node scripts/devkit-sync.mjs --force",
    "devkit:help": "node scripts/devkit-sync.mjs --help",
    "devkit:paths": "pnpm exec kb-devkit-paths",
    "devkit:sync": "node scripts/devkit-sync.mjs",
    "devkit:sync:ci": "node scripts/devkit-sync.mjs --ci-only",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "lint": "pnpm -r exec eslint .",
    "lint:fix": "pnpm -r exec eslint . --fix",
    "postinstall": "pnpm -s devkit:sync || true",
    "predevkit:check": "pnpm devkit:paths",
    "predevkit:force": "pnpm devkit:paths",
    "predevkit:sync": "pnpm devkit:paths",
    "predevkit:sync:ci": "pnpm devkit:paths",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --passWithNoTests --coverage",
    "test:watch": "vitest --passWithNoTests",
    "type-check": "tsc --noEmit"
  },
  "bugs": "https://github.com/kirill-baranov/kb-labs-plugin-template/issues",
  "devDependencies": {
    "@kb-labs/devkit": "workspace:*",
    "@types/node": "^24.3.3",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "prettier": "^3",
    "rimraf": "^6",
    "tsup": "^8",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "24.x",
    "pnpm": ">=9.0.0"
  },
  "homepage": "https://github.com/kirill-baranov/kb-labs-plugin-template#readme",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml}": [
      "prettier -w"
    ],
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ]
  },
  "packageManager": "pnpm@11.4.0",
  "repository": "kirill-baranov/kb-labs-plugin-template.git",
  "workspaces": [],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin-manifest": {
      "types": "./dist/manifest.v3.d.ts",
      "import": "./dist/manifest.v3.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./rest": {
      "types": "./dist/rest/index.d.ts",
      "import": "./dist/rest/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle/index.d.ts",
      "import": "./dist/lifecycle/index.js"
    }
  },
  "kb": {
    "manifest": "./dist/manifest.v3.js"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@kb-labs/sdk": "workspace:*"
  }
}
