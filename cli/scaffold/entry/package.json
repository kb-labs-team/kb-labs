{
  "name": "@kb-labs/scaffold",
  "description": "Built-in commands for scaffolding KB Labs plugins and adapters.",
  "version": "2.120.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/commands",
    "templates"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --passWithNoTests",
    "test:cli": "vitest run --config vitest.cli.config.ts --passWithNoTests",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@kb-labs/scaffold-contracts": "workspace:*",
    "@kb-labs/scaffold-core": "workspace:*",
    "@kb-labs/shared-command-kit": "workspace:*",
    "@kb-labs/sdk": "workspace:*"
  },
  "devDependencies": {
    "@kb-labs/devkit": "workspace:*",
    "@kb-labs/plugin-contracts": "workspace:*",
    "@kb-labs/shared-testing-e2e": "workspace:*",
    "@types/node": "^24.3.3",
    "eslint": "^9",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "24.x",
    "pnpm": ">=9.0.0"
  },
  "sideEffects": false
}
