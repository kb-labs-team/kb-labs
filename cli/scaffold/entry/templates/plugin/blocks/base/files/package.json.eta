{
  "name": "<%= it.pluginId %>",
  "version": "0.1.0",
  "type": "module",
  "description": "<%= it.vars.description %>",
  "license": "<%= it.vars.license %>",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./plugin-manifest": { "types": "./dist/manifest.d.ts", "import": "./dist/manifest.js" },
    "./core": { "types": "./dist/core/index.d.ts", "import": "./dist/core/index.js" },
    "./contracts": { "types": "./dist/contracts/index.d.ts", "import": "./dist/contracts/index.js" }
  },
  "kb": { "manifest": "./dist/manifest.js" },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@kb-labs/sdk": "<%= it.versions.sdkSpec ?? '^' + it.versions.sdk %>"
  },
  "devDependencies": {
    "@kb-labs/devkit": "<%= it.versions.devkitSpec ?? '^' + it.versions.devkit %>",
    "@types/node": "^24.0.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
