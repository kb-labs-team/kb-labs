packages: []

# Older pnpm releases can report an allowlist mismatch as a hard error.
# Keep the explicit allowlist above, but let the generated workspace install
# with a warning when running under such a release.
strictDepBuilds: false

# pnpm 10+ blocks dependency build scripts unless they are explicitly
# allowed in workspace settings. Keep a fresh scaffold non-interactive and
# make the native builds required by the generated plugin toolchain reliable.
allowBuilds:
  '@kb-labs/devkit': true
  '@parcel/watcher': true
  '@swc/core': true
  better-sqlite3: true
  esbuild: true
  unrs-resolver: true

# Compatibility with pnpm versions that predate the allowBuilds map.
onlyBuiltDependencies:
  - '@kb-labs/devkit'
  - '@parcel/watcher'
  - '@swc/core'
  - better-sqlite3
  - esbuild
  - unrs-resolver
