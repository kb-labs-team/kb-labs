import { defineCommand, type CLIInput, type PluginContextV3 } from '@kb-labs/sdk';
import { hello } from '../../core/hello.js';
import { handleError, validationError } from '../../utils/error.js';

type HelloFlags = {
  who?: string;
  json?: boolean;
};

/**
 * `kb <%= it.name %> hello` — prints a friendly greeting.
 *
 * This handler demonstrates the standard error-handling pattern:
 *   1. Validate args/flags with validationError() — before the try/catch
 *   2. Wrap the core call in try/catch, forward errors via handleError()
 *   3. In JSON mode: success = raw data, errors = { ok: false, error: { ... } }
 *
 * See src/utils/error.ts to extend handleError() for your API error class.
 */
export default defineCommand({
  id: '<%= it.name %>:hello',
  description: 'Say hello from <%= it.name %>',

  handler: {
    async execute(ctx: PluginContextV3, input: CLIInput<HelloFlags>) {
      // 1. Validate — synchronous, before try/catch
      if (input.flags.who !== undefined && input.flags.who.trim() === '') {
        validationError(ctx, '--who cannot be empty', input.flags.json);
        return { ok: false, error: 'INVALID_ARGS', result: null };
      }

      // 2. Call core, wrap in try/catch
      try {
        const { greeting } = hello({ who: input.flags.who ?? 'World' });

        if (input.flags.json) {
          ctx.ui?.json?.({ greeting });
        } else {
          ctx.ui?.info?.(greeting);
        }

        return { ok: true, result: { greeting } };
      } catch (err) {
        handleError(ctx, err, input.flags.json);
        return { ok: false, error: err instanceof Error ? err.message : String(err), result: null };
      }
    },
  },
});
