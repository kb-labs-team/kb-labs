    "@kb-labs/devkit": "workspace:*",
    "@kb-labs/shared-testing-e2e": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/ws": "^8.5.14",
    "bcryptjs": "^2.4.3",
    "eslint": "^9",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
