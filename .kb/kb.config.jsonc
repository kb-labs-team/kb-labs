{
  "platform": {
    "mode": "development",
    "deployment": { "topology": "local" },
    "adapters": {
      "storage": "@kb-labs/adapters-fs",
      "cache": "@kb-labs/adapters-state-broker",
      "eventBus": "@kb-labs/adapters-eventbus-cache",
      "documentDatabase": "@kb-labs/adapters-sqlite",
      "kvStore": "@kb-labs/adapters-sqlite/kv",
      "logger": "@kb-labs/adapters-pino",
      "logRingBuffer": "@kb-labs/adapters-log-ringbuffer",
      "logPersistence": "@kb-labs/adapters-log-document",
      "analytics": "@kb-labs/adapters-analytics-sqlite",
      "serviceTransport": "@kb-labs/adapters-service-transport-http"
    },
    "adapterOptions": {
      "storage": {
        "baseDir": "storage"
      },
      "cache": {
        "url": "http://127.0.0.1:7777",
        "namespace": "kb:"
      },
      "serviceTransport": {
        "services": {
          "rest": {
            "url": "http://127.0.0.1:5050"
          },
          "workflow": {
            "url": "http://127.0.0.1:7778"
          },
          "marketplace": {
            "url": "http://127.0.0.1:5070"
          },
          "marketplace-registry": {
            "url": "http://127.0.0.1:5071"
          },
          "mcp-daemon": {
            "url": "http://127.0.0.1:7779"
          }
        }
      },
      "documentDatabase": {
        "filename": "database/kb.sqlite"
      },
      "kvStore": {
        "filename": "database/kb.sqlite"
      },
      "analytics": {
        "dbPath": "analytics/analytics.sqlite"
      },
      "logger": {
        "level": "info",
        "streaming": {
          "enabled": true,
          "bufferSize": 1000,
          "bufferMaxAge": 3600000
        }
      },
      "logRingBuffer": {
        "maxSize": 100
      },
      "logPersistence": {
        "collection": "logs",
        "batchSize": 100,
        "flushInterval": 5000,
        "retention": {
          "maxAgeFatal": 2592000000,
          "maxAgeError": 1209600000,
          "maxAgeWarn": 604800000,
          "maxAgeInfo": 1800000,
          "maxAgeDebug": 1800000,
          "cleanupIntervalMs": 300000
        }
      },
    },
    "execution": {
      "mode": "worker-pool"
    }
  },
  "profiles": [
    {
      "id": "default",
      "label": "Default Profile",
      "products": {
        "mind": {
          "defaultIndex": "code",
          "indexes": {
            "code": {
              "label": "Workspace code (all source minus marketing site & scaffolds)",
              "scope": {
                "include": [
                  "."
                ],
                "exclude": [
                  "sites/**",
                  "templates/**"
                ]
              },
              "retrieval": {
                "rerank": true,
                "dedup": true
              }
            },
            "docs": {
              "label": "Docs & ADRs",
              "scope": "**/docs",
              "chunk": {
                "maxTokens": 300
              },
              "retrieval": {
                "hyde": true
              }
            }
          },
          "retrieval": {
            "limit": 10,
            "rerank": true,
            "dedup": true,
            "hyde": false
          },
          "confidence": {
            "floor": 0.3
          }
        },
        "release": {
          "versioningStrategy": "lockstep",
          "publish": {
            "packageManager": "pnpm"
          },
          "workspace": {
            "type": "pnpm",
            "root": "."
          },
          "packages": {
            "exclude": [
              "templates/*",
              "{{.Name}}",
              "@product-name/*",
              "tmp/notifier-test",
              "tmp/notifier-test/*",
              "tmp/notifier-test/packages/*"
            ]
          },
          "flows": {
            "platform": {
              "versioningStrategy": "lockstep",
              "platformRequires": [
                "llm"
              ],
              "platformMembers": [
                "@kb-labs/cli-bin",
                "@kb-labs/core-workspace",
                "@kb-labs/host-agent-app"
              ],
              "packages": {
                "exclude": [
                  "templates/*",
                  "e2e/journey/fixtures/*",
                  "{{.Name}}",
                  "@product-name/*",
                  "tmp/notifier-test",
                  "tmp/notifier-test/*",
                  "tmp/notifier-test/packages/*"
                ]
              },
              "checks": [
                {
                  "id": "dist-exports",
                  "name": "dist/index.js — no directory imports",
                  "command": "bash",
                  "args": [
                    "scripts/gates/check-dist-exports.sh"
                  ],
                  "timeoutMs": 30000,
                  "blocking": true,
                  "runIn": "perPackage"
                },
                {
                  "id": "pack-static",
                  "name": "packed artifacts — static checks (one process)",
                  "builtin": "pack-static",
                  "timeoutMs": 120000,
                  "blocking": true,
                  "dependsOn": ["dist-exports"],
                  "runIn": "perPackage",
                  "skipPackages": [ "@kb-labs/devkit", "@kb-labs/shared-testing-platform", "@kb-labs/shared-testing" ]
                },
                {
                  "id": "pack-install",
                  "name": "aggregated clean install of staged tarballs + one import pass",
                  "builtin": "pack-install",
                  "timeoutMs": 900000,
                  "dependsOn": ["dist-exports", "pack-static"],
                  "runIn": "perPackage",
                  "skipPackages": [ "@kb-labs/devkit", "@kb-labs/shared-testing-platform", "@kb-labs/shared-testing" ],
                  "packInstall": {
                    "isolatedPackages": ["@kb-labs/sdk", "@kb-labs/platform-client"],
                    "isolateChanged": true,
                    "maxIsolatedChanged": 15,
                    "detectApps": true,
                    "appPackages": ["@kb-labs/mcp-app", "@kb-labs/rest-api-app", "@kb-labs/gateway-app", "@kb-labs/studio-app", "@kb-labs/marketplace-app", "@kb-labs/marketplace-registry-app", "@kb-labs/workflow-daemon", "@kb-labs/core-state-daemon"]
                  }
                },
                {
                  "id": "pack-install-per-package",
                  "name": "LEGACY per-package pack + clean install (debug: kb release checks run --only pack-install-per-package)",
                  "command": "bash",
                  "args": ["scripts/gates/check-pack-install.sh"],
                  "timeoutMs": 120000,
                  "disabled": true,
                  "runIn": "perPackage"
                }
              ]
            }
          },
          "git": {},
          "changelog": {
            "outputPath": "CHANGELOG.md",
            "locale": "en",
            "groups": [
              {
                "title": "Core & SDK",
                "emoji": "🏗️",
                "scopes": [
                  "core",
                  "sdk",
                  "shared",
                  "cli",
                  "devkit",
                  "platform-client",
                  "llm-router",
                  "telemetry"
                ]
              },
              {
                "title": "Gateway & API",
                "emoji": "🌐",
                "scopes": [
                  "gateway",
                  "rest-api"
                ]
              },
              {
                "title": "Adapters",
                "emoji": "🔌",
                "scopes": [
                  "adapters",
                  "adapters-fs",
                  "adapters-openai",
                  "adapters-redis",
                  "adapters-mongodb",
                  "adapters-qdrant",
                  "adapters-pino",
                  "data-store",
                  "adapters-sqlite",
                  "adapters-vibeproxy"
                ]
              },
              {
                "title": "Plugins",
                "emoji": "🧩",
                "scopes": [
                  "workflow",
                  "marketplace",
                  "agents",
                  "mind",
                  "commit",
                  "review",
                  "release",
                  "quality",
                  "qa",
                  "impact",
                  "policy",
                  "state",
                  "host-agent",
                  "devlink",
                  "infra-worker"
                ]
              },
              {
                "title": "Studio",
                "emoji": "🎨",
                "scopes": [
                  "studio"
                ]
              }
            ]
          },
          "checks": [
            {
              "id": "dist-exports",
              "name": "dist/index.js — no directory imports",
              "command": "bash",
              "args": [
                "scripts/gates/check-dist-exports.sh"
              ],
              "timeoutMs": 30000,
              "blocking": true,
              "runIn": "perPackage"
            },
            {
              "id": "pack-static",
              "name": "packed artifacts — static checks (one process)",
              "builtin": "pack-static",
              "timeoutMs": 120000,
              "blocking": true,
              "dependsOn": ["dist-exports"],
              "runIn": "perPackage"
            },
            {
              "id": "pack-install",
              "name": "aggregated clean install of staged tarballs + one import pass",
              "builtin": "pack-install",
              "timeoutMs": 900000,
              "dependsOn": ["dist-exports", "pack-static"],
              "runIn": "perPackage",
              "packInstall": {
                "isolatedPackages": ["@kb-labs/sdk", "@kb-labs/platform-client"],
                "isolateChanged": true,
                "maxIsolatedChanged": 15,
                "detectApps": true,
                "appPackages": ["@kb-labs/mcp-app", "@kb-labs/rest-api-app", "@kb-labs/gateway-app", "@kb-labs/studio-app", "@kb-labs/marketplace-app", "@kb-labs/marketplace-registry-app", "@kb-labs/workflow-daemon", "@kb-labs/core-state-daemon"]
              }
            },
            {
              "id": "pack-install-per-package",
              "name": "LEGACY per-package pack + clean install (debug: kb release checks run --only pack-install-per-package)",
              "command": "bash",
              "args": ["scripts/gates/check-pack-install.sh"],
              "timeoutMs": 120000,
              "disabled": true,
              "runIn": "perPackage"
            },
            {
              "id": "typecheck",
              "command": "pnpm",
              "args": [
                "run",
                "type-check"
              ],
              "timeoutMs": 120000,
              "optional": true,
              "runIn": "scopePath"
            },
            {
              "id": "lint",
              "command": "pnpm",
              "args": [
                "run",
                "lint"
              ],
              "timeoutMs": 60000,
              "optional": true,
              "runIn": "scopePath"
            },
            {
              "id": "tests",
              "command": "pnpm",
              "args": [
                "run",
                "test"
              ],
              "timeoutMs": 120000,
              "optional": true,
              "runIn": "scopePath"
            }
          ]
        },
        "review": {
          "defaultPreset": "kb-labs-full",
          "presetsDir": "review/presets",
          "presets": [
            "review/presets/kb-labs-full.json"
          ],
          "llm": {
            "minTurns": 3,
            "maxTurns": 25,
            "filesPerTurn": 10,
            "linesPerTurn": 500
          }
        },
        "qa": {
          "packages": {
            "paths": [
              "core/*",
              "sdk/*",
              "cli/*",
              "shared/*",
              "plugins/*",
              "adapters/*",
              "studio/*"
            ]
          },
          "checks": [
            {
              "id": "build",
              "command": "pnpm",
              "args": [
                "run",
                "build"
              ],
              "runIn": "perPackage",
              "timeoutMs": 120000,
              "ordered": true
            },
            {
              "id": "lint",
              "command": "pnpm",
              "args": [
                "run",
                "lint"
              ],
              "runIn": "perPackage",
              "timeoutMs": 60000
            },
            {
              "id": "typecheck",
              "command": "pnpm",
              "args": [
                "run",
                "type-check"
              ],
              "runIn": "perPackage",
              "timeoutMs": 60000
            },
            {
              "id": "test",
              "command": "pnpm",
              "args": [
                "run",
                "test"
              ],
              "runIn": "perPackage",
              "timeoutMs": 60000
            }
          ],
          "categories": {
            "core": {
              "label": "Core",
              "packages": [
                "core/*"
              ]
            },
            "sdk": {
              "label": "SDK & Shared",
              "packages": [
                "sdk/*",
                "shared/*"
              ]
            },
            "cli": {
              "label": "CLI",
              "packages": [
                "cli/*"
              ]
            },
            "adapters": {
              "label": "Adapters",
              "packages": [
                "adapters/*"
              ]
            },
            "plugins": {
              "label": "Plugins",
              "packages": [
                "plugins/*"
              ]
            },
            "studio": {
              "label": "Studio",
              "packages": [
                "studio/*"
              ]
            },
            "templates": {
              "label": "Templates",
              "packages": [
                "templates/*/*"
              ]
            }
          }
        },
        "commit": {}
      }
    }
  ],
  "gateway": {
    "access": {
      "mode": "local"
    },
    "port": 4000,
    "host": "127.0.0.1",
    "upstreams": {
      "rest": {
        "serviceId": "rest",
        "url": "http://localhost:5050",
        "prefix": "/api/v1",
        "websocket": true,
        "description": "REST API — main platform BFF"
      },
      "workflow": {
        "serviceId": "workflow",
        "url": "http://localhost:7778",
        "prefix": "/api/exec",
        "rewritePrefix": "",
        "description": "Workflow Daemon — direct access"
      },
      "marketplace": {
        "serviceId": "marketplace",
        "url": "http://localhost:5070",
        "prefix": "/api/v1/marketplace",
        "description": "Marketplace Service — unified entity management"
      },
      "widgets": {
        "serviceId": "rest",
        "url": "http://localhost:5050",
        "prefix": "/plugins",
        "description": "Plugin widget bundles — served by REST API"
      },
      "marketplace-registry": {
        "serviceId": "marketplace-registry",
        "url": "http://localhost:5071",
        "prefix": "/api/v1/registry",
        "rewritePrefix": "/api/v1",
        "description": "Marketplace Registry — publish, share, install kb:handle/name packages"
      },
      "mcp": {
        "serviceId": "mcp-daemon",
        "url": "http://localhost:7779",
        "prefix": "/api/v1/mcp",
        "websocket": false,
        "description": "MCP Daemon — plugin commands as tools for external agents"
      }
    },
    "auth": {
      "enabled": false,
      "bootstrap": {
        "tenantId": "kblabs-cloud",
        "adminEmail": "admin@e2e.test"
      }
    },
    "staticTokens": {
      "dev-studio-token": {
        "hostId": "studio",
        "namespaceId": "default"
      },
      "dev-runtime-server-token": {
        "hostId": "runtime-server-local",
        "namespaceId": "default"
      },
      "dev-host-agent-token": {
        "hostId": "host_local",
        "namespaceId": "default"
      }
    }
  },
  "plugins": {
    "commit": {
      "enabled": true,
      "llm": {
        "enabled": true,
        "temperature": 0.3,
        "maxTokens": 5000
      },
      "storage": {
        "directory": ".kb/commit"
      },
      "git": {
        "protectedBranches": [
          "main",
          "master"
        ],
        "autoStage": false
      }
    },
    "impact": {
      "docRules": [
        {
          "match": "@kb-labs/sdk",
          "docs": [
            "CLAUDE.md",
            "CONTRIBUTING.md"
          ],
          "action": "review"
        },
        {
          "match": "*-cli",
          "docs": [
            "docs/CLI-REFERENCE.md"
          ],
          "action": "regenerate",
          "command": "pnpm kb docs generate-cli-reference"
        },
        {
          "match": "@kb-labs/mind-*",
          "action": "reindex",
          "command": "pnpm kb mind rag-index --scope default"
        }
      ]
    }
  },
  "marketplace": {
    "sync": {
      "include": [
        "plugins/*",
        "adapters/*"
      ]
    },
    "registry": {
      "url": "http://localhost:5071",
      "comment": "Set KB_REGISTRY_TOKEN env var (gateway JWT) for publish auth. For prod: https://registry.kblabs.ru"
    }
  },
  "qa": {
    "ci": {
      "provider": "github-actions",
      "repository": "kb-labs-team/kb-labs",
      "dataBranch": "ci-data",
      "artifactRetentionDays": 90,
      "workflows": [
        "e2e-platform.yml"
      ]
    }
  }
}
