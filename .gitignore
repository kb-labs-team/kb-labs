# ───────────────
# Node & Package managers
# ───────────────
node_modules/
.pnpm-store/
.pnp.*
.pnp.js
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ───────────────
# Build artifacts
# ───────────────
dist/
build/
.cache/
.temp/
tmp/
*.tsbuildinfo
*.tgz

# ───────────────
# Testing
# ───────────────
coverage/
coverage.out
.vitest/
.vscode-test/
.test-analytics/

# ───────────────
# Tool caches
# ───────────────
.wrangler/

# ───────────────
# IDE & OS junk
# ───────────────
.idea/
.vscode/
*.swp
*.swo
*.DS_Store
Thumbs.db

# ───────────────
# Environment & configs
# ───────────────
.env
.env.*.local
.env.local
*.local

# ───────────────
# Private / local-only
# ───────────────
_private/
.worktrees/
.claire/

# ───────────────
# Next.js build artifacts
# ───────────────
.next/

# ───────────────
# KB Labs runtime data
# ───────────────
.kb/cache/
.kb/logs/
.kb/tmp/
# Legacy/not-yet-migrated per-project runtime state (see docs/architecture/target/13-runtime-state-inventory.md)
.kb/runtime/
.kb/traces/
.kb/mind/
/mind/
.kb/devkit/
# Runtime storage for the `verdaccio` kb-dev service — the service's own
# config.yaml (checked in, mounted read-only) stays tracked.
.kb/verdaccio/*
!.kb/verdaccio/config.yaml
.kb/bundle/
.kb/release/history/
.kb/release/backup.json

# ───────────────
# Deploy runtime data (docker volumes, db state)
# ───────────────
deploy/docker/

# ───────────────
# custom
# ───────────────
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
.kb/analytics/
.kb/database/
.kb/commit/
# Agent/memory session state (runtime, not source)
.kb/agents/sessions/
.kb/memory/sessions/

# kb-labs-ignore
.env
.kb/analytics/
.kb/cache/
.kb/storage/
.kb/tmp/
.kb/logs/
# installer-managed — use .kb/devservices.dev.yaml for local dev
.kb/devservices.yaml
# installer-managed overlay state
.kb/generated/
# end-kb-labs-ignore

# E2E — packed tarballs (generated by pack-all.sh, baked into Docker image)
e2e/packages/*.tgz

# E2E — Playwright report output (generated by test runs)
e2e/tests/report/
e2e/*/report/
e2e/*/test-results/

# Claude Code — local settings and session state (per-developer).
# Project skills are shared instructions and must be versioned.
.claude/*
!.claude/skills/
!.claude/skills/**

# KB Labs AI pipeline runtime artifacts (generated by github-issue-to-pr, never commit)
.kb/ai-review/
.kb/qa/snapshots/
.kb/run-artifacts/
# Implementation plan — lives in PR description, not in the repo
PLAN.md

# Mimocode AI assistant state (per-developer runtime)
.mimocode/

# Nested .kb/ runtime dirs inside packages (created during local dev)
plugins/**/.kb/
tools/**/.kb/
core/**/.kb/
adapters/**/.kb/
shared/**/.kb/
sdk/**/.kb/
services/**/.kb/
studio/**/.kb/
cli/**/.kb/
infra/**/.kb/
**/.npmrc

# Compiled Go CLI binaries — built locally via ./bootstrap.sh or `make -C tools/<tool> build`,
# never committed (git filemode tracking on these caused repeated exec-bit regressions)
tools/kb-create/kb-create
tools/kb-dev/kb-dev
tools/kb-deploy/kb-deploy
tools/kb-devkit/kb-devkit
tools/kb-monitor/kb-monitor
tools/kb-env/kb-env

# Module Federation dev-mode type cache (Rspack)
**/.__mf__temp/

# Release candidate bundles are build output produced by the release workflow
# (.kb/workflows/scripts/dispatch-release-candidate.mjs); keep them out of
# `git status` so the release preflight clean-tree probe is not tripped.
.kb/release/candidates/

# Tarballs `release stage plan` publishes to the staging registry; the pack-static /
# pack-install checks verify these instead of re-packing.
.kb/release/staging/
