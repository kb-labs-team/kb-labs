{
  "schema": "kb.create.platform-layout/v2",
  "currentLink": "current",
  "versionRoots": {
    "path": "versions"
  },
  "sharedStateDirectory": "state",
  "packageManagerStateDirectory": "state/package-manager",
  "installerStateDirectory": "installer",
  "hostStateDirectory": "installer/host",
  "platformDataRoot": { "platformPath": ".kb/data", "statePath": "state/data" },
  "ownershipRecord": "ownership.json",
  "ownershipRecordStagingPrefix": ".ownership.json.pending-",
  "ownedEntries": [
    "current",
    "versions",
    "state",
    "installer",
    "ownership.json"
  ],
  "sharedRuntimePaths": [
    { "platformPath": ".kb/v2/cache", "statePath": "state/cache", "kind": "directory", "preinstall": true },
