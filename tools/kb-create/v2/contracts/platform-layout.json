    { "platformPath": ".kb/kb.config.jsonc", "statePath": "state/kb.config.jsonc", "kind": "file", "preserveUserState": true },
    { "id": "secretState", "platformPath": ".kb/v2/secret-state.json", "statePath": "state/secret-state.json", "kind": "file", "preinstall": true, "preserveUserState": true },
    { "platformPath": ".kb/logs", "statePath": "state/logs", "kind": "directory", "preinstall": true },
    { "platformPath": ".kb/diagnostics", "statePath": "state/diagnostics", "kind": "directory", "preinstall": true }
  ],
  "versionStatePaths": [
    { "path": ".kb/marketplace.lock", "kind": "file", "preserveUserState": true }
  ],
  "installerRecords": {
    "operationLogs": "installer/logs",
    "failureDossiers": "installer/diagnostics",
    "snapshots": "installer/snapshots",
    "snapshotRetention": 2
  },
  "runtimeStatePaths": [
    ".kb/v2/cache",
    ".kb/v2/scenarios",
    ".kb/kb.config.jsonc",
    ".kb/v2/secret-state.json",
    ".kb/logs",
    ".kb/diagnostics"
  ]
